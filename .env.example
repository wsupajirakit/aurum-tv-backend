# Aurum TV API — configuration. Copy to .env (git-ignored) for local runs:
#   cp .env.example .env
# Variables already set by the shell, Docker or the hosting platform always win over .env.
# Generate keys with:  go run ./cmd/aurumctl genkey

# development | production (production refuses to start without HMAC_KEYS)
APP_ENV=development
PORT=3000

# ---- Data (keep it on a persistent volume) ----
# channels.json, sessions.json, source-health.json, logs/ and the generated JWT secret live here.
DATA_DIR=./data

# ---- Admin ----
# Admin key(s) for write endpoints, sent as the X-API-Key header (never as a query string).
# Several keys separated by commas let you rotate without downtime.
API_KEY=
# true = reads are open when HMAC is off; with HMAC on, reads still need a signature (see HMAC_REQUIRE_READ)
PUBLIC_READ=true
# Lifetime of the admin JWT issued by POST /api/auth/token
ADMIN_TOKEN_TTL_SEC=604800
# Secret that signs every JWT. Empty = generated once and kept in DATA_DIR (survives redeploys).
JWT_SECRET=

# ---- TV app authentication (HMAC request signing + sessions) ----
# enforce (default) = unsigned app requests get 401 · log = allow but log · off = no signing
HMAC_MODE=enforce
# keyId:secret pairs separated by commas (several = rotate without downtime)
HMAC_KEYS=
# Allowed clock difference between the TV and the server, in seconds
HMAC_MAX_SKEW_SEC=300
# true = reading the channel list also needs a signature (admin key holders can always read)
HMAC_REQUIRE_READ=true
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
# The previous refresh token stays valid this long after rotation (a response can be lost)
REFRESH_GRACE_SEC=60

# ---- Network / hardening ----
# true only behind a reverse proxy (Coolify/Traefik): the client address is taken from X-Forwarded-For
TRUST_PROXY=true
# Requests per IP per minute (0 = no limit)
RATE_LIMIT_PER_MIN=120
# * or a comma-separated list of origins
CORS_ORIGINS=*
BODY_LIMIT_BYTES=1048576
# Enables GET /api/test/ch3 (admin JWT required)
ENABLE_DIAGNOSTICS=false

# ---- App logs (one JSON file per day in DATA_DIR/logs) ----
ENABLE_LOGS=true
LOG_MAX_BATCH=200
LOG_BODY_LIMIT_BYTES=524288

# ---- Resolver sources (signed links that expire) ----
CH3_SOURCE_URL=https://ch3plus.com/live
STREAM_FETCH_TIMEOUT_MS=10000
# Renew a link this long before it expires
STREAM_RENEW_BEFORE_SEC=7200
STREAM_REFRESH_EVERY_MS=1800000
# Hosts (and their subdomains) the app may sync a link from
SYNC_ALLOWED_HOSTS=byteark.com

# ---- Self-healing: probe sources for real and fail over to verified backups ----
HEALTH_ENABLED=true
# The active source is probed every interval; backups every HEALTH_BACKUP_EVERY_CYCLES intervals
HEALTH_INTERVAL_MS=300000
HEALTH_CONCURRENCY=4
HEALTH_BACKUP_EVERY_CYCLES=3
HEALTH_DOWN_BACKOFF_MAX_CYCLES=8
# Consecutive failures before "down" / successes before "up" (prevents flapping)
HEALTH_FAIL_THRESHOLD=2
HEALTH_RECOVER_THRESHOLD=2
HEALTH_CONFIRM_DELAY_MS=3000
# Switch back to the primary source once it has recovered
HEALTH_PREFER_PRIMARY=true
# Minimum time between two app reports for the same channel
HEALTH_REPORT_COOLDOWN_MS=30000
HEALTH_PROBE_TIMEOUT_MS=10000
HEALTH_MAX_PLAYLIST_BYTES=2097152
HEALTH_SEGMENT_BYTES=4096
# lowest (saves bandwidth) | highest
HEALTH_PROBE_VARIANT=lowest
