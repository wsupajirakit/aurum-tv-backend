# Settings for aurumctl (the operator tools). Copy to ops.env — it is git-ignored — and fill in:
#   cp ops.env.example ops.env && chmod 600 ops.env

# URL of the deployed backend (https only — the admin key never travels over http; localhost excepted)
TV_API_URL=https://tv-api.example.com

# Admin key = the backend's API_KEY (never put it in the app's .env)
TV_ADMIN_API_KEY=

# Optional
# CH3_SOURCE_URL=https://ch3plus.com/live
# OPS_TIMEOUT_MS=15000
# OPS_PROBE_TIMEOUT_MS=10000
# OPS_PROBE_CONCURRENCY=4

# smoke (signed like the TV app)
# SMOKE_URL=http://localhost:3000
# SMOKE_KEY_ID=tv1
# SMOKE_SECRET=
# SMOKE_REAL_SOURCE=false
